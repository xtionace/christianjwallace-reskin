# Copy to .env. Never commit .env.
# Names only. The values below are local placeholders, not secrets.

# MongoDB connection string. Required for build, migrate, and start.
DATABASE_URI=mongodb://127.0.0.1:27017/christianjwallace

# Long random string. Signs Payload auth cookies and encrypts secrets.
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=CHANGE_ME_to_a_long_random_string

# Public origin, no trailing slash. Example: https://christianjwallace.com
# NEXT_PUBLIC_SERVER_URL=

# New admin uploads. Default is ./media in the app directory.
# On the VPS this is /srv/christianjwallace/media.
# Shipped images and the card video stay in public/media.
# PAYLOAD_MEDIA_DIR=./media

# Listen port. next start reads this. The VPS process uses 3001.
# PORT=3001

# Optional. The migrate script creates this admin only when both are set.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Optional contact notification. Nothing is emailed until these are set and the code is added.
# RESEND_API_KEY=
CONTACT_NOTIFY_TO=contact@christianjwallace.com
# CONTACT_FROM_EMAIL=
