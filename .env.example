# Copy to .env. Never commit .env or the SQLite database.
# Extra $0 — local SQLite only. No hosted database, no paid email, no paid services.
# Indexing: leave VERCEL_ENV unset so production can be crawled.
# Set VERCEL_ENV=preview to keep a deployment noindex (badge, robots.txt, sitemap).

# SQLite file used by Payload. Relative paths resolve from the project root.
# On Vercel production this becomes a libsql:// URL. Names only — see docs/production-plan.md.
DATABASE_URL=file:./reskin-base.db

# Long random string. Signs Payload auth cookies and encrypts secrets.
# Generate one with: openssl rand -base64 32
# Required. The app reads this only from the environment. There is no hard-coded secret.
PAYLOAD_SECRET=CHANGE_ME_to_a_long_random_string

# Set only for a remote libSQL database. Leave unset for the local file.
# DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Production canonical origin. Leave unset locally.
# NEXT_PUBLIC_SERVER_URL=

# Optional later. Not required while media lives in public/.
# BLOB_READ_WRITE_TOKEN=

# Optional contact notification. Nothing is emailed until these are set and the code is added.
# RESEND_API_KEY=
# Public inbox for a future notification. The form does not send mail yet.
CONTACT_NOTIFY_TO=contact@christianjwallace.com
# CONTACT_FROM_EMAIL=
